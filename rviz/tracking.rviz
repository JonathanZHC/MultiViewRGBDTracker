Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Camera 0 Visible Points1
        - /Camera 0 Visible Points1/Status1
      Splitter Ratio: 0.5
    Tree Height: 492
  - Class: rviz_common/Selection
    Name: Selection
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
