Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.25
      Plane: XY
      Reference Frame: world
    - Class: rviz_default_plugins/PointCloud2
      Name: Camera 0 Visible Points
      Enabled: true
      Topic:
        Value: /tracking/camera_0/visible_points
      Size (Pixels): 3
      Style: Points
      Color Transformer: RGB8
      Queue Size: 2
    - Class: rviz_default_plugins/PointCloud2
      Name: Camera 1 Visible Points
      Enabled: true
      Topic:
        Value: /tracking/camera_1/visible_points
      Size (Pixels): 3
      Style: Points
      Color Transformer: RGB8
      Queue Size: 2
    - Class: rviz_default_plugins/MarkerArray
      Name: Camera 0 Tracks
      Enabled: true
      Topic:
        Value: /tracking/camera_0/markers
    - Class: rviz_default_plugins/MarkerArray
      Name: Camera 1 Tracks
      Enabled: true
      Topic:
        Value: /tracking/camera_1/markers
    - Class: rviz_default_plugins/Image
      Name: Camera 0 Overlay
      Enabled: true
      Topic:
        Value: /tracking/camera_0/rgb_overlay
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: Camera 1 Overlay
      Enabled: true
      Topic:
        Value: /tracking/camera_1/rgb_overlay
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: Camera 0 Raw Masks
      Enabled: false
      Topic:
        Value: /tracking/camera_0/raw_masks
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: Camera 0 Filtered Masks
      Enabled: false
      Topic:
        Value: /tracking/camera_0/filtered_masks
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: Camera 1 Raw Masks
      Enabled: false
      Topic:
        Value: /tracking/camera_1/raw_masks
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: Camera 1 Filtered Masks
      Enabled: false
      Topic:
        Value: /tracking/camera_1/filtered_masks
      Normalize Range: true
  Global Options:
    Background Color: 34; 34; 38
    Fixed Frame: world
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.4
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.5
      Pitch: 0.55
      Yaw: 0.8
Window Geometry:
  Height: 1000
  Width: 1600
  X: 80
  Y: 40
