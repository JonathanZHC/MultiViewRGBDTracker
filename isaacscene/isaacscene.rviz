Panels:
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Primary fused cloud1
    - /Camera frustums and images1
    Splitter Ratio: 0.55
  Tree Height: 560
- Class: rviz_common/Selection
  Name: Selection
- Class: rviz_common/Tool Properties
  Expanded: []
  Name: Tool Properties
  Splitter Ratio: 0.5
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
  - Alpha: 0.45
    Cell Size: 0.25
    Class: rviz_default_plugins/Grid
    Color: 120; 120; 125
    Enabled: true
    Line Style:
      Line Width: 0.03
      Value: Lines
    Name: Table grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 20
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/TF
    Enabled: true
    Frame Timeout: 15
    Marker Alpha: 0.8
    Marker Scale: 0.35
    Name: Camera TF
    Show Arrows: true
    Show Axes: true
    Show Names: true
    Update Interval: 0
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 1
      Min Value: 0
      Value: true
    Axis: Z
    Channel Name: rgb
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: RGB8
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 1
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: Primary fused cloud
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 2
    Size (m): 0.006
    Style: Flat Squares
    Topic:
      Depth: 2
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /cameras/fused_points
    Use Fixed Frame: true
    Use rainbow: false
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 1
      Min Value: 0
      Value: true
    Axis: Z
    Channel Name: rgb
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: RGB8
    Decay Time: 0
    Enabled: false
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 1
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: Camera 0 cloud
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 2
    Size (m): 0.006
    Style: Flat Squares
    Topic:
      Depth: 2
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /camera_0/points
    Use Fixed Frame: true
    Use rainbow: false
    Value: false
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 1
      Min Value: 0
      Value: true
    Axis: Z
    Channel Name: rgb
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: RGB8
    Decay Time: 0
    Enabled: false
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 1
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: Camera 1 cloud
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 2
    Size (m): 0.006
    Style: Flat Squares
    Topic:
      Depth: 2
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /camera_1/points
    Use Fixed Frame: true
    Use rainbow: false
    Value: false
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Camera frustums and images
    Namespaces:
      camera_axes: true
      camera_body: true
      camera_frustum: true
      camera_image_plane: true
      camera_labels: true
      camera_optical_axis: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /cameras/visualization
    Value: true
  - Class: rviz_default_plugins/Image
    Enabled: true
    Max Value: 1
    Median window: 5
    Min Value: 0
    Name: Camera 0 RGB
    Normalize Range: true
    Topic:
      Depth: 2
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /camera_0/color/image_raw
    Value: true
  - Class: rviz_default_plugins/Image
    Enabled: true
    Max Value: 1
    Median window: 5
    Min Value: 0
    Name: Camera 1 RGB
    Normalize Range: true
    Topic:
      Depth: 2
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /camera_1/color/image_raw
    Value: true
  - Class: rviz_default_plugins/Camera
    Enabled: false
    Image Rendering: overlay
    Name: Camera 0 calibrated view
    Overlay Alpha: 0.5
    Queue Size: 2
    Topic:
      Depth: 2
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /camera_0/color/image_raw
    Value: false
    Zoom Factor: 1
  - Class: rviz_default_plugins/Camera
    Enabled: false
    Image Rendering: overlay
    Name: Camera 1 calibrated view
    Overlay Alpha: 0.5
    Queue Size: 2
    Topic:
      Depth: 2
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /camera_1/color/image_raw
    Value: false
    Zoom Factor: 1
  Enabled: true
  Global Options:
    Background Color: 35; 35; 38
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.2
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0.75
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.55
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 4.0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: false
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1600
  X: 80
  Y: 40
